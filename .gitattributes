# Vendored third-party files stay byte-for-byte as downloaded (their SHA-256s are recorded in
# backend/app/live/static/README.md), so git must not rewrite their line endings.
backend/app/live/static/vendor/** -text

# Shell scripts and Dockerfiles run on Linux (Docker / Hugging Face): always LF.
*.sh text eol=lf
Dockerfile text eol=lf

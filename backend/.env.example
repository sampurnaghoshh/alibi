# Copy to backend/.env (never commit .env)
#
# BUDGET RULE: we spend no money on APIs.
# The demo runs with ALIBI_LLM_PROVIDER=none: claims come from the offline rules path
# and explanations from templates. Free, offline, deterministic. An LLM never decides a verdict.
#
# Providers:
#   none      = default. Free and offline. Use this for the demo.
#   gemini    = recommended OPTIONAL provider. Free Google AI Studio key (see README).
#               Use a key from a Google Cloud project WITHOUT billing enabled, so it can never be charged.
#   anthropic = paid, do not use.

ALIBI_LLM_PROVIDER=none
ALIBI_LLM_MODEL=               # empty = default: gemini-2.5-flash-lite (gemini free tier)
GEMINI_API_KEY=
ALIBI_LLM_EXPLAIN=0            # 1 = also reword findings with the LLM (~6 extra calls per investigation)
ANTHROPIC_API_KEY=             # anthropic = paid, do not use

# --- Telegram bot (Live Desk, python -m app.bot). Free. Never commit real values. ---
TELEGRAM_BOT_TOKEN=            # from @BotFather; never log or share it
TELEGRAM_ALLOWED_CHAT_IDS=     # comma-separated chat ids that are always allowed, e.g. 123456789,-1001234567890
TELEGRAM_PASSCODE=             # other chats are approved by sending: /start <passcode>
ALIBI_API_URL=http://127.0.0.1:8000
